# Copy to .env.local for local runs. Do not commit real secrets.

CHAIN_SERVICES_RUNTIME_ENV=local
SECURITY_PREFLIGHT_STRICT=false
LOG_REDACTION_ENABLED=true
BROADCAST_MAX_IN_FLIGHT_PER_ORDER=1
BROADCAST_MAX_RETRY_ATTEMPTS=3
BROADCAST_RETRY_BASE_MS=250
BROADCAST_RETRY_MAX_MS=5000
BROADCAST_RECEIPT_TIMEOUT_MS=0

UVP_CHAIN_ID=31337
UVP_RPC_URL=http://127.0.0.1:8545
UVP_DEPLOYMENT_BLOCK=0
UVP_FINALITY_CONFIRMATIONS=1
UVP_REORG_BUFFER_BLOCKS=8
UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/anvil.local.json
# Optional manual override. Leave unset when UVP_ADDRESS_MANIFEST is present.
# UVP_CONTRACTS_JSON={"UVPStateMachine":"0x1111111111111111111111111111111111111111","UVPIdentityRegistry":"0x2222222222222222222222222222222222222222"}

# Projection data is a cache over chain events. It must be wipeable and rebuilt.
CHAIN_SERVICES_DATABASE_DRIVER=memory
CHAIN_SERVICES_DATABASE_URL=memory://projection-store

# Evidence bytes stay off chain. Local is for developer runs only; testnet
# rehearsal must use the object-style adapter below.
UVP_EVIDENCE_STORAGE_ADAPTER=local
# UVP_EVIDENCE_STORAGE_DIR=./cache/evidence

UVP_API_HOST=127.0.0.1
UVP_API_PORT=8787
UVP_INDEXER_POLL_INTERVAL_MS=5000
# Local browser E2E only. Do not enable in staging or production.
# UVP_PRODUCT_E2E_FIXTURES=1

# Gas-payer identity only. The relayer must never hold or create business signatures.
UVP_RELAYER_TX_SIGNER_REF=local-keystore:relayer-gas-payer

# Docked-signal keeper.
UVP_DOCKED_SIGNAL_AUTOMATION_ENABLED=true
UVP_DOCKED_SIGNAL_REQUIRE_TRUSTED_PLANS=false
UVP_DOCKED_SIGNAL_MAX_CANDIDATES_PER_RUN=4
UVP_DOCKED_SIGNAL_MAX_GAS_PER_TX=500000
UVP_DOCKED_SIGNAL_WAIT_FOR_RECEIPT=true

# Product BFF order registration. Default memory mode records pending
# registration state only; it does not claim the order is on-chain.
UVP_PRODUCT_BFF_REGISTRATION_ADAPTER=memory
UVP_PRODUCT_BFF_REGISTRAR_PRIVATE_KEY_ENV=UVP_PRODUCT_BFF_REGISTRAR_PRIVATE_KEY
UVP_PRODUCT_BFF_WAIT_FOR_RECEIPT=false
# UVP_PRODUCT_BFF_REGISTRAR_PRIVATE_KEY=0x...
# UVP_PRODUCT_BFF_CREATOR_ADDRESS=0x1111111111111111111111111111111111111111

# Background tx/receipt/projection reconciliation.
RECONCILE_WORKER_ENABLED=false
RECONCILE_POLL_INTERVAL_MS=5000
RECONCILE_TX_TIMEOUT_MS=1800000

# Base Sepolia rehearsal profile. Do not commit populated secrets.
# CHAIN_SERVICES_RUNTIME_ENV=testnet
# SECURITY_PREFLIGHT_STRICT=true
# CHAIN_SERVICES_DATABASE_DRIVER=postgres
# CHAIN_SERVICES_DATABASE_URL=postgres://uvp:change-me@testnet-db.internal:5432/uvp
# CHAIN_SERVICES_MIGRATIONS_AUTO_RUN=true
# UVP_INDEXER_POLL_INTERVAL_MS=0
# RECONCILE_POLL_INTERVAL_MS=30000
# UVP_CHAIN_ID=84532
# UVP_RPC_URL=https://base-sepolia-rpc.example
# UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/testnet.json
# UVP_PRODUCT_BFF_REGISTRATION_ADAPTER=anvil
# UVP_PRODUCT_BFF_REGISTRAR_PRIVATE_KEY_ENV=UVP_PRODUCT_BFF_REGISTRAR_PRIVATE_KEY
# UVP_STATE_MACHINE_RELAYER_BROADCAST_ENABLED=true
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY_ENV=UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY
# UVP_DOCKED_SIGNAL_AUTOMATION_ENABLED=true
# UVP_DOCKED_SIGNAL_REQUIRE_TRUSTED_PLANS=true
# UVP_EVIDENCE_STORAGE_ADAPTER=rehearsal-object
# UVP_EVIDENCE_OBJECT_NAMESPACE=uvp-testnet-rehearsal
# UVP_EVIDENCE_OBJECT_ROOT_DIR=./cache/evidence-object-testnet
# RECONCILE_WORKER_ENABLED=true
