# Copy to .env.local for local runs. Do not commit real secrets.

CHAIN_SERVICES_RUNTIME_ENV=local
SECURITY_PREFLIGHT_STRICT=false
LOG_REDACTION_ENABLED=true
BROADCAST_MAX_IN_FLIGHT_PER_ORDER=1
BROADCAST_MAX_RETRY_ATTEMPTS=3
BROADCAST_RETRY_BASE_MS=250
BROADCAST_RETRY_MAX_MS=5000
BROADCAST_RECEIPT_TIMEOUT_MS=0

UVP_CHAIN_ID=31337
UVP_RPC_URL=http://127.0.0.1:8545
UVP_DEPLOYMENT_BLOCK=0
# Reorg safety of the indexer: the cursor's finality anchor defaults to the
# chain's finalized tag (UVP_FINALITY_ANCHOR=finalized when unset), which
# rules out deep reorgs inside the finality boundary. This local example
# targets anvil, which has no meaningful finalized tag, so the explicit
# confirmations override is on.
UVP_FINALITY_ANCHOR=confirmations
UVP_FINALITY_CONFIRMATIONS=1
UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/anvil.local.json
# Optional manual override. Leave unset when UVP_ADDRESS_MANIFEST is present.
# UVP_CONTRACTS_JSON={"UVPStateMachine":"0x1111111111111111111111111111111111111111","UVPIdentityRegistry":"0x2222222222222222222222222222222222222222"}

# Chain projection + relay op state is a cache/operation log over chain events.
# Storage is Postgres-only: CHAIN_SERVICES_DATABASE_URL is the single storage env
# and startup fails when it is unset or not a postgres:// DSN. For local runs,
# start the bundled container with `./scripts/with-postgres.sh` (or just run
# `pnpm test`, which starts it automatically) and point the URL at it.
CHAIN_SERVICES_DATABASE_URL=postgres://uvp:uvp@127.0.0.1:5432/uvp_chain_services

UVP_API_HOST=127.0.0.1
UVP_API_PORT=8787
UVP_INDEXER_POLL_INTERVAL_MS=5000

# Gas-payer identity only. The relayer must never hold or create business signatures.
UVP_RELAYER_TX_SIGNER_REF=local-keystore:relayer-gas-payer

# State Machine relayer broadcast. UVP_STATE_MACHINE_RELAYER_BROADCAST_ENABLED
# defaults to whether the relayer private key env var is set. When the runtime is
# not local, or broadcast was explicitly enabled, a usable broadcaster plus a
# non-empty private key is mandatory and startup fails otherwise.
# UVP_STATE_MACHINE_RELAYER_BROADCAST_ENABLED=false
UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY_ENV=UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY=0x...

# Background projection + relay receipt reconciliation.
RECONCILE_WORKER_ENABLED=false
RECONCILE_POLL_INTERVAL_MS=5000
RECONCILE_TX_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Non-local profiles. Business env (Store auth, evidence, governance, BFF,
# order birth) lives in uvp-app-backend, not here. These keys are the chain
# runtime contract; OPS_CONSOLE_ADMIN_IDS + CHAIN_SERVICES_ADMIN_TOKEN_HASHES
# are the admin gate for /admin/*.
# ---------------------------------------------------------------------------

# Base Sepolia / testnet
# CHAIN_SERVICES_RUNTIME_ENV=testnet
# SECURITY_PREFLIGHT_STRICT=true
# CHAIN_SERVICES_DATABASE_URL=postgres://uvp:change-me@testnet-db.internal:5432/uvp
# UVP_INDEXER_POLL_INTERVAL_MS=5000
# RECONCILE_POLL_INTERVAL_MS=30000
# UVP_CHAIN_ID=84532
# UVP_RPC_URL=https://base-sepolia-rpc.example
# UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/testnet.json
# UVP_STATE_MACHINE_RELAYER_BROADCAST_ENABLED=true
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY_ENV=UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY=0x...
# RECONCILE_WORKER_ENABLED=true
# OPS_CONSOLE_ADMIN_IDS=ops-1
# CHAIN_SERVICES_ADMIN_TOKEN_HASHES=<64-char-sha256-hex>

# staging
# CHAIN_SERVICES_RUNTIME_ENV=staging
# SECURITY_PREFLIGHT_STRICT=true
# CHAIN_SERVICES_DATABASE_URL=postgres://uvp:change-me@staging-db.internal:5432/uvp
# UVP_INDEXER_POLL_INTERVAL_MS=5000
# UVP_CHAIN_ID=84532
# UVP_RPC_URL=https://base-sepolia-rpc.example
# UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/staging.json
# UVP_STATE_MACHINE_RELAYER_BROADCAST_ENABLED=true
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY_ENV=UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY=0x...
# UVP_RELAYER_GAS_PAYER_ADDRESS=0x...
# RECONCILE_WORKER_ENABLED=true
# OPS_CONSOLE_ADMIN_IDS=ops-1
# CHAIN_SERVICES_ADMIN_TOKEN_HASHES=<64-char-sha256-hex>

# production
# CHAIN_SERVICES_RUNTIME_ENV=production
# SECURITY_PREFLIGHT_STRICT=true
# LOG_REDACTION_ENABLED=true
# CHAIN_SERVICES_DATABASE_URL=postgres://uvp:change-me@prod-db.internal:5432/uvp
# Explicit indexer poll interval on managed Postgres (0 additionally needs
# UVP_INDEXER_POLL_DISABLED_ACK=1).
# UVP_INDEXER_POLL_INTERVAL_MS=5000
# UVP_CHAIN_ID=8453
# UVP_RPC_URL=https://prod-rpc.example
# UVP_ADDRESS_MANIFEST=../uvp-deploy/deploy/addresses/production.json
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY_ENV=UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY
# UVP_STATE_MACHINE_RELAYER_PRIVATE_KEY=0x...
# RECONCILE_WORKER_ENABLED=true
# OPS_CONSOLE_ADMIN_IDS=ops-1
# CHAIN_SERVICES_ADMIN_TOKEN_HASHES=<64-char-sha256-hex>
